# Copy this file to .env and fill in real values. Never commit .env.
# The app checks these when it starts (lib/env.ts) and stops with a clear message if any are wrong.

# --- Database (Neon) -------------------------------------------------------
# Neon dashboard → your project → Connect.
# Pooled connection (Connection pooling ON, host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (Connection pooling OFF, same host without "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Authentication (Clerk) — needed from Phase 2 ----------------------------
# Clerk dashboard → your application → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
